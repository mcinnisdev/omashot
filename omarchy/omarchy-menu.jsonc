{
  // Omashot in the Omarchy menu (SUPER + ALT + SPACE, or `omarchy menu`).
  //
  // Merge these keys into ~/.config/omarchy/extensions/omarchy-menu.jsonc.
  // The file is yours and may already have entries in it, so the installer
  // will not overwrite it -- it copies this in only when the file is still
  // the untouched sample, and otherwise points you here.
  //
  // On Omarchy the menu is where a keyless action belongs, so everything
  // Omashot can do is here whether or not it is on a key.

  "omashot": {
    "icon": "󰹑",
    "label": "Omashot",
    "description": "Shoot the screen, note it, hand it off"
  },

  "omashot.shot": {
    "icon": "󰹑",
    "label": "Take a shot",
    "description": "One shot with a note, copied ready to paste",
    "action": "omashot shot"
  },
  "omashot.copy": {
    "icon": "󰆏",
    "label": "Copy loose shots",
    "description": "Copy everything not in a brief, and clear it",
    "action": "omashot copy"
  },
  "omashot.add": {
    "icon": "󰐕",
    "label": "Add to the brief",
    "description": "Put a noted shot into the open brief",
    "action": "omashot add"
  },
  "omashot.trail": {
    "icon": "󰄀",
    "label": "Trail what I do",
    "description": "Collect a shot at every step, hands free",
    "action": "omashot trail"
  },
  "omashot.record": {
    "icon": "󰑋",
    "label": "Record the screen",
    "description": "A walkthrough someone will actually watch",
    "action": "omashot record"
  },
  "omashot.section": {
    "icon": "󰉋",
    "label": "Next section",
    "description": "Close this section of the brief and start the next",
    "action": "omashot section"
  },
  "omashot.brief": {
    "icon": "󰈙",
    "label": "Open the brief",
    "description": "Review, reorder and note what you have shot",
    "action": "omashot brief"
  },
  "omashot.done": {
    "icon": "󰄬",
    "label": "Brief is done",
    "description": "Write it out and copy its path for an agent",
    "action": "omashot done"
  },
  "omashot.folder": {
    "icon": "󰝰",
    "label": "Open the Omashot folder",
    "action": "omarchy-launch-nautilus ${OMASHOT_DIR:-$HOME/Omashot}"
  }
}
